{
  "title": "IP-SAKTI Request Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "panels": [
    {"title":"Stage error rate","type":"timeseries","targets":[{"expr":"sum by (stage) (rate(ip_sakti_stage_errors_total[5m]))","legendFormat":"{{stage}}"}]},
    {"title":"Stage p95 latency","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, sum by (le, stage) (rate(ip_sakti_stage_duration_seconds_bucket[5m])))","legendFormat":"{{stage}}"}]},
    {"title":"Retrieval result rate","type":"timeseries","targets":[{"expr":"sum(rate(ip_sakti_stage_requests_total{stage=~\"retrieval|reranking\"}[5m]))","legendFormat":"requests/s"}]},
    {"title":"Escalations","type":"timeseries","targets":[{"expr":"sum by (priority) (increase(ip_sakti_escalations_total[1h]))","legendFormat":"{{priority}}"}]}
  ]
}
