project_id    = "replace-with-your-gcp-project"
environment   = "staging"
region        = "asia-south1"
db_tier       = "db-f1-micro"
backend_image = "asia-south1-docker.pkg.dev/replace-with-your-gcp-project/ip-sakti-staging-containers/backend:v0.1.0"
allowed_origins = ["https://staging-app.example.com"]
trusted_hosts = ["staging-api.example.com"]
notification_provider = "webhook"
rate_limit_backend = "gateway"
